<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DiffBeacon</AssemblyName>
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DiffBeacon.Core/DiffBeacon.Core.csproj" />
    <ProjectReference Include="../DiffBeacon.Providers/DiffBeacon.Providers.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="TiffLibrary" Version="0.6.65" />
    <None Include="TiffLibrary.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="JpegLibrary.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../tests/Fixtures/Archives/Zip.deflate.WinzipAES.zip" LogicalName="DiffBeacon.SelfTest.Encrypted.zip" />
    <EmbeddedResource Include="../../tests/Fixtures/Archives/Sources/two-passwords.zip" LogicalName="DiffBeacon.SelfTest.Sources.two-passwords.zip" />
    <EmbeddedResource Include="../../tests/Fixtures/Archives/7Zip.solid.7z" LogicalName="DiffBeacon.SelfTest.Wrappers.7Zip.solid.7z" />
    <EmbeddedResource Include="../../tests/Fixtures/Archives/Rar5.solid.rar" LogicalName="DiffBeacon.SelfTest.Wrappers.Rar5.solid.rar" />
    <EmbeddedResource Include="../../tests/Fixtures/Archives/Wrappers/metadata-golden.json" LogicalName="DiffBeacon.SelfTest.Wrappers.Metadata.json" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/same-first-left.gif" LogicalName="DiffBeacon.SelfTest.Images.same-first-left.gif" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/same-first-right.gif" LogicalName="DiffBeacon.SelfTest.Images.same-first-right.gif" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/short.gif" LogicalName="DiffBeacon.SelfTest.Images.short.gif" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/disposal.gif" LogicalName="DiffBeacon.SelfTest.Images.disposal.gif" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/disposal-2.png" LogicalName="DiffBeacon.SelfTest.Images.disposal-2.png" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageHighlight/winimerge-image-highlight-golden.json" LogicalName="DiffBeacon.SelfTest.ImageHighlight.json" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageCopy/winimerge-image-copy-golden.json" LogicalName="DiffBeacon.SelfTest.ImageCopy.json" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageInsertions/winimerge-insertions-golden.json.gz" LogicalName="DiffBeacon.ImageInsertions.Golden.json.gz" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageInsertionHighlight/winimerge-insertion-highlight-golden.json.gz" LogicalName="DiffBeacon.ImageInsertionHighlight.Golden.json.gz" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/Apng/*.png" LogicalName="DiffBeacon.SelfTest.Apng.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/Apng/expectations.json" LogicalName="DiffBeacon.SelfTest.Apng.expectations.json" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/Tiff/*.tif" LogicalName="DiffBeacon.SelfTest.Tiff.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/Tiff/*.tiff" LogicalName="DiffBeacon.SelfTest.Tiff.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../tests/Fixtures/Images/Tiff/expectations.json" LogicalName="DiffBeacon.SelfTest.Tiff.expectations.json" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageTransforms/input.png" LogicalName="DiffBeacon.SelfTest.ImageTransforms.input.png" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageTransforms/ui-golden.json.gz" LogicalName="DiffBeacon.SelfTest.ImageTransforms.json.gz" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageOffsets/winimerge-offsets-golden.json" LogicalName="DiffBeacon.SelfTest.ImageOffsets.json" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageRectangles/cases.json" LogicalName="DiffBeacon.SelfTest.ImageRectangles.Cases.json" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageRectangles/winimerge-rectangles-golden.json.gz" LogicalName="DiffBeacon.SelfTest.ImageRectangles.Golden.gz" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageResize/cases.json" LogicalName="DiffBeacon.SelfTest.ImageResize.Cases.json" />
    <EmbeddedResource Include="../../tests/Fixtures/ImageResize/winimerge-resize-golden.json.gz" LogicalName="DiffBeacon.SelfTest.ImageResize.Golden.gz" />
  </ItemGroup>
</Project>
