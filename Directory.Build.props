<Project>
  <Import Project="Directory.Build.local.props" Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(GITHUB_ACTIONS)' != 'true' and Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <PropertyGroup Condition="'$(DiffBeaconWorkRoot)' != ''">
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(DiffBeaconWorkRoot)\direct\build</ArtifactsPath>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DiffBeacon.App' or '$(MSBuildProjectName)' == 'DiffBeacon.E2E'">
    <Compile Include="$(MSBuildThisFileDirectory)build/DevelopmentOutputGuard.cs" Link="DevelopmentOutputGuard.cs" />
    <AssemblyMetadata Include="DiffBeaconDevelopmentWorkRoot" Value="$(DiffBeaconWorkRoot)" Condition="'$(DiffBeaconWorkRoot)' != ''" />
  </ItemGroup>
</Project>
