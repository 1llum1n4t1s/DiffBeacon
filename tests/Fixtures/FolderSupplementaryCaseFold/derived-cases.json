  {"id":"capture-original", "expression":"@ci AllEqual(Array(RegexExtract('𐐀!','(𐐨)(!)',1),'𐐀')) and AllEqual(Array(RegexExtract('𐐀!','(𐐨)(!)',2),'!'))"},
  {"id":"capture-quantifier", "expression":"@ci AllEqual(Array(RegexExtract('𐐀𐐀!','(𐐨+)(!)',1),'𐐀𐐀'))"},
  {"id":"bmp-ci", "expression":"@ci AllEqual(Array(RegexReplace('AΣſ','aσs','X'),'X'))"},
