[
  {"id":"scope-enable", "expression":"@cs AllEqual(Array(RegexReplace('𐐀','(?i:𐐨)','X'),'X'))"},
  {"id":"scope-disable", "expression":"@ci AllEqual(Array(RegexReplace('𐐀','(?-i:𐐨)','X'),'𐐀'))"},
  {"id":"scope-restore-cs", "expression":"@cs AllEqual(Array(RegexReplace('𐐀𐐀','(?i:𐐨)𐐨','X'),'𐐀𐐀'))"},
  {"id":"scope-restore-ci", "expression":"@ci AllEqual(Array(RegexReplace('𐐀𐐀','(?-i:𐐀)𐐨','X'),'X'))"},
  {"id":"quantifier-ci", "expression":"@ci AllEqual(Array(RegexReplace('𐐀𐐀','𐐨+','X'),'X'))"},
